# ── Telegram ──────────────────────────────────────────────────────────────────
# Get this from @BotFather on Telegram
TELEGRAM_TOKEN=your-telegram-bot-token-here
BOT_USERNAME=@YourBotUsername

# ── LLM Provider ──────────────────────────────────────────────────────────────
# "claude" (default) or "ollama"
LLM_PROVIDER=claude

# Claude (used when LLM_PROVIDER=claude)
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-sonnet-4-6
# Longest single answer in tokens (~4 chars each); longer answers are cut with a notice
CLAUDE_MAX_TOKENS=1024
# Smaller model that turns long answers into a short spoken version (voice notes)
CLAUDE_SPEECH_MODEL=claude-haiku-4-5-20251001

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Voice (speech-to-text + text-to-speech) ───────────────────────────────────
# "elevenlabs" or "none" (voice disabled — voice notes get a text reply)
VOICE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=your-voice-id-here
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# opus_48000_* → native Telegram voice bubble; mp3_44100_128 → audio player
VOICE_OUTPUT_FORMAT=opus_48000_64

# Guardrails: TTS credits are billed per character, STT per audio minute
MAX_TTS_CHARS=500
MAX_VOICE_SECONDS=120
# Replies up to this many characters, with no headers/lists/code, are spoken as-is
SPEAK_DIRECT_MAX_CHARS=350
# One JSON line per voice turn (numbers only, no transcripts); empty to disable
VOICE_METRICS_PATH=voice_metrics.jsonl

# ── Memory ────────────────────────────────────────────────────────────────────
DB_PATH=chatbot.db
MAX_CONTEXT_TOKENS=4000

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
